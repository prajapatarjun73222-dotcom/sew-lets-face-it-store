# Server
PORT=5000
NODE_ENV=development

# MongoDB - local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/sewletsfaceit

# JWT - use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173

# Stripe (https://dashboard.stripe.com/test/apikeys). Leave empty to disable online checkout.
# Use sk_test_... keys while testing; switch to sk_live_... when the shop goes live.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <API URL>/api/orders/webhook (whsec_...).
# Locally, `stripe listen --forward-to localhost:5000/api/orders/webhook` prints one.
STRIPE_WEBHOOK_SECRET=

# Used only by `npm run seed:admin` to create / update the demo administrator.
# Password must be at least 10 characters and include upper, lower case letters and a number.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Demo Admin
